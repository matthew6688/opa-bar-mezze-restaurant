---
import Layout from '../layouts/Layout.astro';
import { loadRestaurantContent, loadRestaurantDesign, paletteVars } from '../lib/restaurantArtifacts';

const content = loadRestaurantContent();
const design = loadRestaurantDesign();
const styles = paletteVars(design);
const sections = content.menu?.sections || [];
const sourceUrl = content.menu?.sourceUrl || '';
const sectionAnchors = sections.map((section: any) => ({
  id: slugify(section.name),
  name: section.name,
}));

function slugify(value: string) {
  return value
    .toLowerCase()
    .replace(/&/g, ' and ')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-+|-+$/g, '');
}
---

<Layout title={'Menu - ' + content.hero.name} description={'Official menu preview for ' + content.hero.name} brandName={content.hero.name} showSalesBar={false} showChrome={false}>
  <section class="menu-app" style={styles}>
    <header class="menu-bar">
      <div class="menu-bar-copy">
        <p>Menu</p>
        <h1>{content.hero.name}</h1>
      </div>
      {content.cta.callUrl && <a class="menu-bar-call" href={content.cta.callUrl}>Call</a>}
    </header>

    <div class="menu-chrome">
      <div class="quick-actions" aria-label="Restaurant actions">
        {content.cta.reserveUrl && <a href={content.cta.reserveUrl}>Reserve</a>}
        {content.cta.mapUrl && <a href={content.cta.mapUrl}>Map</a>}
        {sourceUrl && <a href={sourceUrl}>Source</a>}
      </div>

      {sectionAnchors.length > 1 && (
        <nav class="section-pills" aria-label="Jump to menu sections">
          {sectionAnchors.map((section) => (
            <a href={`#${section.id}`}>{section.name}</a>
          ))}
        </nav>
      )}
    </div>

    <div class="section-list">
      {sections.map((section: any) => {
        const id = slugify(section.name);
        return (
          <section class="menu-section" id={id}>
            <div class="section-title">
              <h2>{section.name}</h2>
              {section.description && <p>{section.description}</p>}
            </div>
            <div class="items">
              {(section.items || []).map((item: any) => (
                <article class="menu-item">
                  <div>
                    <h3>{item.name}</h3>
                    {item.description && <p>{item.description}</p>}
                  </div>
                  {item.price && <strong>{item.price}</strong>}
                </article>
              ))}
            </div>
          </section>
        );
      })}
    </div>

    {!sections.length && (
      <section class="empty-state">
        <h2>Menu artifact required</h2>
        <p>Add a validated content.restaurant.json file with menu.sections before sending this preview.</p>
      </section>
    )}

    <footer class="menu-footer">
      {content.contact.address && <a href={content.cta.mapUrl || undefined}>{content.contact.address}</a>}
      {content.contact.phone && <a href={content.cta.callUrl || undefined}>{content.contact.phone}</a>}
    </footer>
  </section>
</Layout>

<style>
  .menu-app {
    max-width: 680px;
    margin: 0 auto;
    color: var(--wj-ink);
  }

  .menu-bar {
    position: sticky;
    top: 0;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px solid #e6ded4;
    padding: 0.9rem 0 0.8rem;
    background: rgba(251, 250, 247, 0.96);
    backdrop-filter: blur(16px);
  }

  .menu-bar-copy p {
    color: var(--wj-accent);
    font-size: 0.68rem;
    font-weight: 900;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .menu-bar-copy h1 {
    margin-top: 0.1rem;
    font-size: 1.3rem;
    font-weight: 900;
    letter-spacing: 0;
  }

  .menu-bar-call,
  .quick-actions a,
  .section-pills a {
    color: var(--wj-ink);
    font-size: 0.86rem;
    font-weight: 900;
    text-decoration: none;
  }

  .menu-bar-call {
    border: 1px solid #ddd6cc;
    border-radius: 999px;
    padding: 0.55rem 0.85rem;
    background: white;
  }

  .menu-chrome {
    position: sticky;
    top: 70px;
    z-index: 15;
    display: grid;
    gap: 0.7rem;
    padding: 0.8rem 0 1rem;
    background: linear-gradient(180deg, rgba(251, 250, 247, 0.98) 0%, rgba(251, 250, 247, 0.94) 100%);
    backdrop-filter: blur(16px);
  }

  .quick-actions {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.45rem;
  }

  .quick-actions a {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    border: 1px solid #ddd6cc;
    background: #fff;
    transition: transform 160ms ease, background-color 160ms ease, border-color 160ms ease;
  }

  .quick-actions a:first-child {
    background: var(--wj-ink);
    color: #fff;
    border-color: var(--wj-ink);
  }

  .quick-actions a:hover,
  .quick-actions a:focus-visible,
  .section-pills a:hover,
  .section-pills a:focus-visible,
  .menu-bar-call:hover,
  .menu-bar-call:focus-visible {
    transform: translateY(-1px);
  }

  .section-pills {
    display: flex;
    gap: 0.5rem;
    overflow-x: auto;
    padding-bottom: 0.15rem;
    scrollbar-width: none;
  }

  .section-pills::-webkit-scrollbar {
    display: none;
  }

  .section-pills a {
    flex: 0 0 auto;
    border: 1px solid #ddd6cc;
    border-radius: 999px;
    padding: 0.5rem 0.8rem;
    background: #fff;
    white-space: nowrap;
  }

  .section-list {
    display: grid;
    gap: 0;
  }

  .menu-section {
    scroll-margin-top: 8.5rem;
    display: grid;
    gap: 0.95rem;
    border-bottom: 1px solid #ddd6cc;
    padding: 1.75rem 0 1.85rem;
  }

  .section-title h2 {
    font-size: 1.45rem;
    font-weight: 900;
    line-height: 1.1;
  }

  .section-title p {
    margin-top: 0.4rem;
    color: var(--wj-muted);
    font-size: 0.92rem;
    line-height: 1.5;
    max-width: 42ch;
  }

  .items {
    display: grid;
    gap: 0.35rem;
    border-top: 1px solid #e6ded4;
    padding-top: 0.35rem;
  }

  .menu-item {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 1rem;
    align-items: start;
    border-bottom: 1px solid #e6ded4;
    padding: 0.95rem 0;
    background: transparent;
  }

  .menu-item h3 {
    font-size: 1rem;
    font-weight: 900;
    line-height: 1.35;
  }

  .menu-item p {
    margin-top: 0.55rem;
    max-width: 32ch;
    color: #675c52;
    font-size: 0.92rem;
    line-height: 1.5;
  }

  .menu-item strong {
    color: var(--wj-accent);
    font-weight: 900;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .empty-state {
    margin-top: 1rem;
    border-radius: 8px;
    padding: 1.5rem;
    background: #fff7ed;
  }

  .menu-footer {
    display: grid;
    gap: 0.35rem;
    padding: 1.2rem 0 0;
    color: #675c52;
    font-size: 0.86rem;
    line-height: 1.45;
  }

  .menu-footer a {
    color: inherit;
    font-weight: 900;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (min-width: 820px) {
    .menu-app {
      max-width: 760px;
    }

    .menu-chrome {
      top: 76px;
    }
  }
</style>
