---
import Layout from '../layouts/Layout.astro';
import { firstImage, loadRestaurantContent, loadRestaurantDesign, paletteVars } from '../lib/restaurantArtifacts';

const content = loadRestaurantContent();
const design = loadRestaurantDesign();
const styles = paletteVars(design);
const heroImage = firstImage(content);
const reserveUrl = content.cta.reserveUrl || '';
const callUrl = content.cta.callUrl || '';
const mapUrl = content.cta.mapUrl || '';
const menuUrl = content.menu?.sourceUrl || '/menu';
const contactCards = [
  {
    eyebrow: 'Reservations',
    title: 'Book a table',
    copy: reserveUrl ? 'SevenRooms takes guests straight to the booking flow.' : 'Call the restaurant to book a table.',
    href: reserveUrl || callUrl,
    label: reserveUrl ? 'Reserve now' : 'Call now',
  },
  {
    eyebrow: 'Phone',
    title: content.contact.phone,
    copy: 'Speak with the team directly for bookings and dining questions.',
    href: callUrl,
    label: 'Call the restaurant',
  },
  {
    eyebrow: 'Location',
    title: content.contact.address,
    copy: 'Find Opa Bar & Mezze in Brisbane City and open the route in Google Maps.',
    href: mapUrl,
    label: 'Get directions',
  },
  {
    eyebrow: 'Menu',
    title: 'Official menu',
    copy: 'Scan the current dishes and prices before you arrive.',
    href: menuUrl,
    label: 'Open menu',
  },
];
---

<Layout
  title={`Contact - ${content.hero.name}`}
  description={`Plan a visit to ${content.hero.name}. Call, reserve, or get directions to ${content.contact.address}.`}
  brandName={content.hero.name}
>
  <section class="contact-page" style={styles}>
    <section class="hero-section">
      {heroImage && <img class="hero-image" src={heroImage} alt={`${content.hero.name} restaurant interior`} />}
      <div class="hero-overlay"></div>
      <div class="section-inner hero-inner">
        <div class="hero-copy">
          <p class="eyebrow">Contact</p>
          <h1>Plan your visit.</h1>
          <p class="lede">
            {content.hero.name} is a Brisbane City dining room built around shared mezze, direct reservations, and clear practical details before you arrive.
          </p>
          <div class="hero-actions">
            {reserveUrl && <a class="button button-primary" href={reserveUrl}>Reserve a table</a>}
            {mapUrl && <a class="button button-secondary" href={mapUrl}>Get directions</a>}
            {callUrl && <a class="text-link" href={callUrl}>{content.contact.phone}</a>}
          </div>
        </div>
      </div>
    </section>

    <section class="section-block cards-block">
      <div class="section-inner">
        <div class="section-heading">
          <p class="eyebrow">Quick actions</p>
          <h2>Everything guests need in one place.</h2>
          <span>Call, book, navigate, or open the menu without digging through the site.</span>
        </div>
        <div class="contact-grid">
          {contactCards.map((card) => (
            <a class="contact-card" href={card.href || undefined}>
              <span>{card.eyebrow}</span>
              <h3>{card.title}</h3>
              <p>{card.copy}</p>
              <strong>{card.label}</strong>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="section-block details-block">
      <div class="section-inner details-grid">
        <article class="details-panel">
          <p class="eyebrow">Guest confidence</p>
          <h2>{content.hero.rating ? `${content.hero.rating}/5` : 'Verified details'}</h2>
          <p>
            {content.hero.reviewCount ? `${content.hero.reviewCount.toLocaleString()} Google reviews` : 'Google Places evidence and official menu information'} keep the visit details grounded in real sources.
          </p>
        </article>
        <article class="details-panel details-panel-soft">
          <p class="eyebrow">Menu source</p>
          <h2>Official website menu</h2>
          <p>
            The mobile menu uses the restaurant’s published menu source so dishes and prices stay aligned with the official listing.
          </p>
          <a class="text-link" href={menuUrl}>Open the menu</a>
        </article>
      </div>
    </section>
  </section>
</Layout>

<style>
  .contact-page {
    --page-bg: #fbfaf7;
    --dark: color-mix(in srgb, var(--wj-ink), #101522 28%);
    background: var(--page-bg);
    color: var(--wj-ink);
    overflow-x: clip;
  }

  .section-inner {
    width: min(100% - 40px, 1180px);
    margin: 0 auto;
  }

  .hero-section {
    position: relative;
    min-height: clamp(520px, 76vh, 760px);
    display: grid;
    align-items: center;
    overflow: hidden;
    background: var(--dark);
    color: white;
  }

  .hero-image,
  .hero-overlay {
    position: absolute;
    inset: 0;
  }

  .hero-image {
    width: 102%;
    height: 102%;
    left: -1%;
    top: -1%;
    object-fit: cover;
  }

  .hero-overlay {
    background:
      linear-gradient(90deg, rgba(9, 12, 20, 0.92), rgba(9, 12, 20, 0.56) 48%, rgba(9, 12, 20, 0.2)),
      linear-gradient(0deg, rgba(9, 12, 20, 0.4), rgba(9, 12, 20, 0.18));
  }

  .hero-inner {
    position: relative;
    z-index: 2;
    padding: clamp(5rem, 12vw, 9rem) 0;
  }

  .hero-copy {
    max-width: 720px;
  }

  .eyebrow {
    color: var(--wj-accent);
    font-size: 0.72rem;
    font-weight: 900;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  h1 {
    margin-top: 1rem;
    font-size: clamp(3rem, 8vw, 6.2rem);
    line-height: 0.95;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }

  .lede {
    margin-top: 1.25rem;
    max-width: 38rem;
    font-size: 1.08rem;
    line-height: 1.75;
    color: rgba(255, 255, 255, 0.88);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    align-items: center;
    margin-top: 2rem;
  }

  .section-block {
    padding: clamp(3.5rem, 6vw, 5.5rem) 0;
  }

  .section-heading {
    display: grid;
    gap: 0.6rem;
    margin-bottom: 1.5rem;
  }

  .section-heading h2,
  .details-panel h2 {
    font-size: clamp(1.9rem, 4vw, 3rem);
    line-height: 1.06;
    text-wrap: balance;
  }

  .section-heading span,
  .details-panel p,
  .contact-card p {
    color: var(--wj-muted);
    line-height: 1.65;
  }

  .contact-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .contact-card {
    display: grid;
    gap: 0.65rem;
    min-height: 100%;
    padding: 1.35rem;
    border: 1px solid #ddd6cc;
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.78);
    text-decoration: none;
    color: inherit;
    transition: transform 160ms ease, border-color 160ms ease, box-shadow 160ms ease;
  }

  .contact-card:hover,
  .contact-card:focus-visible {
    transform: translateY(-2px);
    border-color: rgba(6, 62, 82, 0.22);
    box-shadow: 0 20px 45px rgba(17, 40, 50, 0.07);
  }

  .contact-card span {
    color: var(--wj-accent);
    font-size: 0.68rem;
    font-weight: 900;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .contact-card h3 {
    font-size: 1.08rem;
    font-weight: 900;
    line-height: 1.3;
  }

  .contact-card strong,
  .text-link {
    color: var(--wj-ink);
    font-weight: 900;
    text-decoration: none;
  }

  .details-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .details-panel {
    padding: 1.5rem;
    border: 1px solid #ddd6cc;
    border-radius: 24px;
    background: rgba(255, 255, 255, 0.88);
  }

  .details-panel-soft {
    background: linear-gradient(180deg, rgba(251, 246, 239, 0.96), rgba(255, 255, 255, 0.88));
  }

  .details-panel p {
    margin-top: 0.75rem;
  }

  .details-panel .text-link {
    display: inline-block;
    margin-top: 1rem;
  }

  @media (max-width: 720px) {
    .contact-grid,
    .details-grid {
      grid-template-columns: 1fr;
    }

    .hero-actions {
      align-items: flex-start;
    }
  }
</style>
